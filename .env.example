# Optional process environment; Spring Boot does not automatically load .env.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Optional model configuration (never commit a real key).
# LLM_ENDPOINT=https://qianfan.baidubce.com/v2/tokenplan/personal
# LLM_MODEL=deepseek-v4.1-flash-1017
# LLM_PROTOCOL=openai-chat
# LLM_API_KEY=

# Optional vision model for scanned invoices (T48). Must be a model that reads images; it never falls back to LLM_*.
# LLM_VISION_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_VISION_MODEL=
# LLM_VISION_PROTOCOL=
# LLM_VISION_API_KEY=
