{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Query": {
      "type": "object",
      "properties": {
        "enterprise_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "month": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        }
      },
      "required": [
        "enterprise_id",
        "month"
      ],
      "additionalProperties": false
    },
    "PurposeCheck": {
      "type": "object",
      "description": "按每张发票日期当日唯一启用的用途规则，列出该企业该月未填用途的发票。只在用户问到用途、缺用途或用途规则的执行情况时调用；只问金额、张数、明细或规则版本时不要附带调用。",
      "properties": {
        "enterprise_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "month": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        }
      },
      "required": [
        "enterprise_id",
        "month"
      ],
      "additionalProperties": false
    },
    "RuleQuery": {
      "type": "object",
      "properties": {
        "enterprise_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "required": [
        "enterprise_id",
        "date"
      ],
      "additionalProperties": false
    },
    "KnowledgeQuery": {
      "type": "object",
      "properties": {
        "enterprise_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "query": {
          "type": "string",
          "pattern": ".*\\S.*",
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "enterprise_id",
        "query"
      ],
      "additionalProperties": false
    },
    "RecallQuery": {
      "type": "object",
      "description": "只读取回当前任务被压缩的原文，没有企业参数。三种用法，字段不可混用：{\"source\":\"TURN\",\"seq\":轮次整数}；{\"source\":\"TOOL_RESULT\",\"call_id\":\"工具调用编号\",\"offset\":起始行,\"limit\":行数≤50}（offset/limit 可省略）；{\"source\":\"FILE\",\"file_id\":\"文件编号\",\"location\":\"与检索结果中的 location 原样一致\",\"limit\":前后段数≤3}（limit 可省略）。",
      "properties": {
        "source": {
          "type": "string",
          "enum": ["TURN", "TOOL_RESULT", "FILE"]
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "call_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "file_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "location": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "InvoiceKey": {
      "type": "object",
      "properties": {
        "enterprise_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "invoice_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        }
      },
      "required": [
        "enterprise_id",
        "invoice_id"
      ],
      "additionalProperties": false
    },
    "RuleKey": {
      "type": "object",
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "version": {
          "type": "string",
          "pattern": ".*\\S.*"
        }
      },
      "required": [
        "rule_id",
        "version"
      ],
      "additionalProperties": false
    },
    "InvoiceUpdate": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/InvoiceKey"
        },
        "changes": {
          "type": "object",
          "properties": {
            "purpose": {
              "type": "string"
            },
            "remarks": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "required": [
        "key",
        "changes"
      ],
      "additionalProperties": false
    },
    "StateRequest": {
      "type": "object",
      "properties": {
        "enterprise_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "action": {
          "type": "string",
          "enum": [
            "GET",
            "PUT",
            "DELETE"
          ]
        },
        "id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": ".*\\S.*"
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "anyOf": [
            {
              "type": "string",
              "pattern": ".*\\S.*"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "enterprise_id",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "PUT"
              }
            }
          },
          "then": {
            "required": [
              "id",
              "content"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": ".*\\S.*"
              },
              "content": {
                "type": "string",
                "pattern": ".*\\S.*"
              }
            }
          },
          "else": {
            "properties": {
              "content": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "DELETE"
              }
            }
          },
          "then": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": ".*\\S.*"
              }
            }
          }
        }
      ]
    },
    "RuleDefinition": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": [
            "启用",
            "已停用"
          ]
        },
        "content": {
          "type": "string",
          "pattern": ".*\\S.*"
        }
      },
      "required": [
        "name",
        "effective_from",
        "status",
        "content"
      ],
      "additionalProperties": false
    },
    "RuleRequest": {
      "type": "object",
      "properties": {
        "enterprise_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "action": {
          "type": "string",
          "enum": [
            "GET",
            "IMPORT",
            "UPDATE",
            "DISABLE"
          ]
        },
        "key": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "definition": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleDefinition"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "enterprise_id",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "IMPORT",
                  "UPDATE"
                ]
              }
            }
          },
          "then": {
            "required": [
              "key",
              "definition"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/RuleKey"
              },
              "definition": {
                "$ref": "#/$defs/RuleDefinition"
              }
            }
          },
          "else": {
            "properties": {
              "definition": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "DISABLE"
              }
            }
          },
          "then": {
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/RuleKey"
              }
            }
          }
        }
      ]
    }
  },
  "description": "Canonical input definitions; select the named $defs entry from TOOL_CONTRACT.md, not the root as a tool input."
}
