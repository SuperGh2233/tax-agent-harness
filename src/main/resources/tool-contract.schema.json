{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Query": {
      "type": "object",
      "properties": {
        "enterprise_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "month": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        }
      },
      "required": [
        "enterprise_id",
        "month"
      ],
      "additionalProperties": false
    },
    "PurposeCheck": {
      "type": "object",
      "properties": {
        "enterprise_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "month": {
          "type": "string",
          "const": "2026-09"
        }
      },
      "required": [
        "enterprise_id",
        "month"
      ],
      "additionalProperties": false
    },
    "InvoiceKey": {
      "type": "object",
      "properties": {
        "enterprise_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "invoice_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        }
      },
      "required": [
        "enterprise_id",
        "invoice_id"
      ],
      "additionalProperties": false
    },
    "RuleKey": {
      "type": "object",
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "version": {
          "type": "string",
          "pattern": ".*\\S.*"
        }
      },
      "required": [
        "rule_id",
        "version"
      ],
      "additionalProperties": false
    },
    "InvoiceUpdate": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/InvoiceKey"
        },
        "changes": {
          "type": "object",
          "properties": {
            "purpose": {
              "type": "string"
            },
            "remarks": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "required": [
        "key",
        "changes"
      ],
      "additionalProperties": false
    },
    "StateRequest": {
      "type": "object",
      "properties": {
        "enterprise_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "action": {
          "type": "string",
          "enum": [
            "GET",
            "PUT",
            "DELETE"
          ]
        },
        "id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": ".*\\S.*"
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "anyOf": [
            {
              "type": "string",
              "pattern": ".*\\S.*"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "enterprise_id",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "PUT"
              }
            }
          },
          "then": {
            "required": [
              "id",
              "content"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": ".*\\S.*"
              },
              "content": {
                "type": "string",
                "pattern": ".*\\S.*"
              }
            }
          },
          "else": {
            "properties": {
              "content": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "DELETE"
              }
            }
          },
          "then": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": ".*\\S.*"
              }
            }
          }
        }
      ]
    },
    "RuleDefinition": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": [
            "启用",
            "已停用"
          ]
        },
        "content": {
          "type": "string",
          "pattern": ".*\\S.*"
        }
      },
      "required": [
        "name",
        "effective_from",
        "status",
        "content"
      ],
      "additionalProperties": false
    },
    "RuleRequest": {
      "type": "object",
      "properties": {
        "enterprise_id": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "action": {
          "type": "string",
          "enum": [
            "GET",
            "IMPORT",
            "UPDATE",
            "DISABLE"
          ]
        },
        "key": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "definition": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleDefinition"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "enterprise_id",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "IMPORT",
                  "UPDATE"
                ]
              }
            }
          },
          "then": {
            "required": [
              "key",
              "definition"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/RuleKey"
              },
              "definition": {
                "$ref": "#/$defs/RuleDefinition"
              }
            }
          },
          "else": {
            "properties": {
              "definition": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "DISABLE"
              }
            }
          },
          "then": {
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/RuleKey"
              }
            }
          }
        }
      ]
    }
  },
  "description": "Canonical input definitions; select the named $defs entry from TOOL_CONTRACT.md, not the root as a tool input."
}
